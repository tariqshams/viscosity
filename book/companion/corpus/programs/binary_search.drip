fn search(xs, target) {
  let lo = 0;
  let hi = len(xs) - 1;
  while lo <= hi {
    let mid = lo + (hi - lo - (hi - lo) % 2) / 2;
    if xs[mid] == target {
      return mid;
    }
    if xs[mid] < target {
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return -1;
}
let xs = [1, 3, 5, 7, 9, 11, 13];
print search(xs, 7); # expect: 3
print search(xs, 1); # expect: 0
print search(xs, 13); # expect: 6
print search(xs, 4); # expect: -1
print search([], 4); # expect: -1

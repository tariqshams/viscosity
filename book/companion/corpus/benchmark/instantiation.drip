# Creating instances: new, init, and garbage.
class Point {
  init(x, y) {
    self.x = x;
    self.y = y;
  }
}

class Segment {
  init(a, b) {
    self.a = a;
    self.b = b;
  }
}

let sum = 0;
for i in 0..200000 {
  let s = new Segment(new Point(i, 0), new Point(0, i));
  sum += s.a.x - s.b.y;
}
print sum; # expect: 0

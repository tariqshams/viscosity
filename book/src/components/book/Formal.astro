---
// Precise notation (a grammar, an inference rule, a set equation, a
// lattice) shown with a plain-words reading of it, so the symbols are
// never left for the reader to decode alone.
//   <Formal title="The typing rule for +">
//   ```text ... ```
//   <span slot="read">...how to say it out loud...</span>
//   </Formal>
// As with Analogy, the span is styled by CSS (.formal [slot='read']), and
// check_chapters.mjs makes sure it is there.
const { title } = Astro.props as { title?: string };
---
<section class="formal">
  <div class="formal-label">{title ?? 'Written precisely'}</div>
  <div class="formal-body"><slot /><slot name="read" /></div>
</section>

---
import Book from '../layouts/Book.astro';
import { href } from '../lib/url';
import { START_HREF } from '../lib/chapters';
---
<Book title="Not found · Viscosity">
  <div class="mx-auto max-w-reading px-4 py-16 text-center sm:px-6">
    <h1 class="font-display text-4xl font-semibold">Page not found</h1>
    <p class="mt-3 text-muted">This chapter may not be written yet.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3 font-sans">
      <a href={START_HREF} class="btn-3d btn-3d-primary px-4 py-2 font-semibold">Start with the preface →</a>
      <a href={href('/')} class="btn-3d px-4 py-2">Back to the contents</a>
    </div>
  </div>
</Book>

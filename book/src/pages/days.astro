---
import Book from '../layouts/Book.astro';
import DayPlan from '../components/book/DayPlan';
import { curriculum } from '../lib/chapters';
import { CORE_DAYS, SECTION_DAYS } from '../data/book.js';
const { days } = await curriculum();
---
<Book title={`The day plan · Viscosity`} current="days">
  <div class="mx-auto max-w-reading px-4 pb-16 pt-8 sm:px-6 lg:pt-12">
    <h1 class="font-display text-[2.2rem] font-semibold leading-tight">The day plan</h1>
    <p class="mb-6 mt-2 font-serif text-[1.08rem] leading-relaxed text-ink/85">
      About an hour a day: your reviews first (a few minutes), then four chapters. If you already know TypeScript, the core path takes {CORE_DAYS} days: you build Drip and its virtual machine, then Viscosity, then learn Rust and rebuild both in it. New to programming? The Prelude ({SECTION_DAYS.prelude} days) comes first. The deep dives ({SECTION_DAYS.deep} days) are for afterwards: parsing and type theory, the rest of the middle end, a native back end, real engines, language features, garbage collection and more Rust.
    </p>
    <DayPlan client:load days={days} />
  </div>
</Book>

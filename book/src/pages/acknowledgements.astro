---
import Book from '../layouts/Book.astro';
import { references } from '../data/references.js';
// Credit people, not just papers: what each person's work shaped here.
const groups: { title: string; ids: string[] }[] = [
  { title: 'The problem Viscosity attacks', ids: ['makor2022', 'kloibhofer2023', 'ziap2025', 'pharrmark2012', 'ispcdocs', 'odin-overview-soa', 'acton2014', 'wurthinger2013'] },
  { title: 'How the book teaches languages and compilers', ids: ['nystrom2021', 'pratt1973', 'coopertorczon2022', 'cytron1991', 'braun2013', 'llvmnewpm', 'bynensmeurer2018', 'holzle1991', 'klabnik2026', 'oxc-project'] },
  { title: 'How the book helps you remember', ids: ['roediger2006', 'paivio1986', 'ye2022', 'fsrs', 'tsfsrs'] },
  { title: 'Reference documentation', ids: ['mdn-functions', 'mdn-objects', 'mdn-equality', 'mdn-console-log', 'mdn-typed-arrays', 'mdn-array'] },
];
const byId = Object.fromEntries(references.map((r) => [r.id, r]));
---
<Book title="Acknowledgements & influences · Viscosity" current="acknowledgements">
  <div class="mx-auto max-w-reading px-4 pb-16 pt-8 sm:px-6 lg:pt-12" data-pagefind-body>
    <h1 class="font-display text-[2.2rem] font-semibold leading-tight">Acknowledgements & influences</h1>
    <div class="prose-body">
      <p>Viscosity and this book stand on other people’s work. This page names those people and says plainly what each one’s ideas shaped. Full citations are in the <a href="/bibliography/">bibliography</a>.</p>
      <p>A special note on <i>Crafting Interpreters</i>: Robert Nystrom’s code and test files are MIT-licensed, and this book’s Drip test suite is adapted from his Lox tests with that licence kept. His prose and illustrations are licensed CC BY-NC-ND 4.0, so nothing here copies or adapts them. The explanations and diagrams in this book are original, and his book is warmly recommended alongside it.</p>
    </div>
    {groups.map((g) => (
      <section class="mt-8">
        <h2 class="font-display text-xl font-semibold">{g.title}</h2>
        <ul class="mt-3 grid list-none gap-3 p-0 font-sans">
          {g.ids.map((id) => { const r = byId[id]; return (
            <li class="border border-line bg-panel px-4 py-3">
              <div class="font-semibold">{r.authors.join(', ')}</div>
              <div class="text-[0.92rem] italic text-ink/80">{r.title}{r.year ? ` (${r.year})` : ''}</div>
              <div class="mt-1 text-[0.95rem] leading-relaxed">{r.shaped}</div>
            </li>
          ); })}
        </ul>
      </section>
    ))}
  </div>
</Book>
